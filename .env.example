# Copy to .env and replace EVERY value marked CHANGE-ME. Generate secrets with: openssl rand -hex 32
ENVIRONMENT=production

POSTGRES_PASSWORD=CHANGE-ME-owner-password
APP_DB_PASSWORD=CHANGE-ME-app-role-password

# >= 32 chars; signs login tokens
JWT_SECRET=CHANGE-ME-generate-with-openssl-rand-hex-32
# first-run administrator (created only when the users table is empty)
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=CHANGE-ME-min-10-chars-with-digits
# shared secret Alertmanager uses to call the webhook
WEBHOOK_TOKEN=CHANGE-ME-webhook-token

GRAFANA_ADMIN_PASSWORD=CHANGE-ME-grafana

# optional: enables the OpenAI-backed agent. Leave empty to use the offline rules engine only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
